/* BUTTON PRIMARY */
#AddSensor {
    background: #0B66C3;
    color: #FFFFFF;
}
#AddSensor:hover {
    background: #0A5AB0;
}

/* WINDOW */
QMainWindow {
    background: #1A1A1A;
    color: #EDEDED;
}

/* SIDEBAR */
#Sidebar {
    background: #0D0D0D;
    border-right: 1px solid #151515;
}

/* CARDS */
#Card, QFrame#Card {
    background: #1F1F1F;
    border: 1px solid #2A2A2A;
}

/* TEXT */
QLabel { color: #EEEEEE; }
QLabel#H1 { color: #FFFFFF; }
QLabel#Small { color: #BBBBBB; }

#MeasureValue { color: #DDDDDD; }

/* PILL COLORS — DARK FRIENDLY */
#MeasurePill[kind="visc"]  { background: #284866; color: #EDEDED; }
#MeasurePill[kind="temp"]  { background: #665C2A; color: #FFFFFF; }
#MeasurePill[kind="dens"]  { background: #2D4A3A; color: #FFFFFF; }
#MeasurePill[kind="pres"]  { background: #4A3A6C; color: #FFFFFF; }

/* BUTTONS */
QPushButton {
    background: #333;
    color: white;
}
QPushButton:hover { background: #444; }

QPushButton#Ghost {
    background: transparent;
    color: white;
}

/* NAV BUTTONS */
#NavPrimary, #NavSecondary {
    background: #222;
    color: white;
}
#NavPrimary:hover, #NavSecondary:hover { background: #333; }

/* TABLE */
QTableWidget {
    background: #1A1A1A;
    color: white;
    border-color: #333;
}
QHeaderView::section {
    background: #111;
    color: #EEE;
}
QTableWidget::item:selected { background: #333; }

/* INPUTS */
QLineEdit, QComboBox {
    background: #222;
    color: #EEE;
    border-color: #444;
}
QComboBox QAbstractItemView {
    background: #222;
    color: white;
}

/* SCROLLBAR */
QScrollBar:vertical { background: #111; }
QScrollBar::handle:vertical { background: #333; }
QScrollBar::handle:vertical:hover { background: #444; }


/* HOVER CARD COLORS (DARK THEME) */
#HoverCard {
    background: #1F1F1F;
    border: 1px solid #2A2A2A;
}

#HoverCard[hover="true"] {
    background: #292929;
}

#ChartFrame {
    background: #1F1F1F;
    border: 1px solid #2A2A2A;
}

#ChartTooltip QLabel#ChartTooltipLabel {
    color: #FFFFFF;
}

/* ----------- WINDOW ----------- */
QMainWindow {
    background: #111111;
    color: #EEEEEE;
}

/* ----------- SIDEBAR ----------- */
#Sidebar {
    background: #000000;
}

/* ----------- CARDS ----------- */
#Card, QFrame#Card {
    background: #1D1D1D;
    border-radius: 12px;
    border: 1px solid #333;
}

/* ----------- TEXT (scoped) ----------- */
/* Regla base segura para Dark */
QLabel { color: #EEEEEE; }

/* Título grande */
QLabel#H1 {
    font-size: 18px;
    font-weight: 600;
    color: #FFFFFF;
}

/* Texto pequeño auxiliar */
QLabel#Small {
    font-size: 14px;
    color: #000;
}

/* Valores numéricos de Measurements */
#MeasureValue {
    font-size: 12px;
    color: #DDDDDD;
}

/* Pills de Measurements (misma estética en ambos temas) */
#MeasurePill {
    border-radius: 10px;
    padding: 6px 12px;
    color: #111;          /* Negro para buen contraste sobre pasteles */
    /* El fondo pastel lo pones inline desde Python para mantener los mismos colores */
}

/* ----------- BUTTONS ----------- */
QPushButton {
    background: #333;
    border-radius: 8px;
    color: white;
    padding: 6px 12px;
}
QPushButton:hover { background: #444; }

QPushButton#Ghost {
    background: transparent;
    border: none;
    color: white;
}

/* ----------- NAV BUTTONS ----------- */
QPushButton#NavPrimary,
QPushButton#NavSecondary {
    background: #222;
    color: white;
    border-radius: 8px;
}
QPushButton#NavPrimary:hover,
QPushButton#NavSecondary:hover { background: #333; }

/* ----------- TABLE ----------- */
QTableWidget {
    background: #1A1A1A;
    color: white;
    gridline-color: #444;
    border: 1px solid #333;
}
QHeaderView::section {
    background: #111;
    color: #EEE;
    padding: 6px;
    border: none;
}
QTableWidget::item { color: #EEE; }
QTableWidget::item:selected { background: #333; }

/* ----------- INPUTS ----------- */
QLineEdit {
    background: #222;
    color: #EEE;
    border: 1px solid #444;
    border-radius: 6px;
}
QComboBox {
    background: #222;
    color: white;
    border: 1px solid #444;
    border-radius: 6px;
}
QComboBox QAbstractItemView {
    background: #222;
    color: white;
}

/* ----------- SCROLLBAR ----------- */
QScrollBar:vertical { background: #111; width: 10px; }
QScrollBar::handle:vertical { background: #333; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #444; }

#KPI_Title {
    font-size: 14px;
    font-weight: 500;
    color: #000;
}

#KPI_Value {
    font-size: 18px;
    font-weight: 600;
    color: #000;
}

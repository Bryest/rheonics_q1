/* MAIN WINDOW */
QMainWindow {
    background: #F5F7FA;
    color: #1A1A1A;
}

/* SIDEBAR */
#Sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E5E5E5;
}

/* Botones primarios */
#NavPrimary {
    background: #FFFFFF;
    color: #1A1A1A;
    border-radius: 8px;
    padding: 10px 12px;
    border: 1px solid #D5D5D5;
}
#NavPrimary:hover { background: #EDEDED; }

/* Secundarios */
#NavSecondary {
    background: #FAFAFA;
    color: #444;
    border-radius: 8px;
    padding: 10px 12px;
    border: 1px solid #E0E0E0;
}
#NavSecondary:hover { background: #E8E8E8; }

/* Botón Rheonics (ghost) */
#Ghost {
    background: #FFFFFF;
    color: #1A1A1A;
    border-radius: 8px;
    padding: 10px 12px;
    border: 1px solid #DADADA;
}
#Ghost:hover { background: #EFEFEF; }

/* CARDS */
#Card {
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #EEE;
}

/* TEXTOS */
QLabel { color: #1A1A1A; }

QLabel#H1 {
    font-size: 18px;
    font-weight: 600;
    color: #1A1A1A;
}
QLabel#Small {
    font-size: 14px;
    color: #555;
}

/* Measurements */
#MeasureValue {
    font-size: 12px;
    color: #333333;
}
#MeasurePill {
    border-radius: 10px;
    padding: 6px 12px;
    color: #111;     /* Negro para contraste, mismo que Dark */
}

#KPI_Title {
    font-size: 14px;
    font-weight: 500;
    color: #4A4A4A;
}

#KPI_Value {
    font-size: 18px;
    font-weight: 600;
    color: #1A1A1A;
}

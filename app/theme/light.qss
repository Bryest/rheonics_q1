/* Figma-like modern UI for Rheonics (clean) */
#MainWindow {
    background: #F4F6F8;
}

#RightPane {
    background: transparent;
}

#H1 {
    font-size: 32px;
    font-weight: 700;
    color: #1F2937;
    padding-bottom: 4px;
}


/* SIDEBAR */
#Sidebar {
    background: #1C1E21;
    color: #FFFFFF;
    border-right: 1px solid #2A2D31;
}

#Brand {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 24px;
}

QPushButton#Ghost {
    color: #D1D5DA;
    border: none;
    padding: 10px;
    font-size: 20px;
    border-radius: 8px;
}

QPushButton#Ghost:hover {
    background: #2A2D31;
}

QPushButton#NavPrimary {
    background: transparent;
    padding: 12px 14px;
    border-radius: 10px;
    text-align: left;
    font-size: 15px;
    color: #E5E7EB;
}

QPushButton#NavPrimary:hover {
    background: #2A2D31;
}

QPushButton#NavPrimary:checked {
    background: #0B5CAD;
    color: #FFFFFF;
}

QPushButton#NavSecondary {
    background: transparent;
    padding: 10px 12px;
    border-radius: 10px;
    text-align: left;
    font-size: 15px;
    color: #CBD0D6;
}

QPushButton#NavSecondary:hover {
    background: #2A2D31;
}


/* CARDS */
#Card {
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid #E5E8EB;
    padding: 20px;
}

[hoverable="true"]:hover {
    background: #ECF5FF;
    border: 1px solid #0B5CAD;
}

#Small {
    font-size: 13px;
    color: #6B7280;
}

#KPI {
    font-size: 26px;
    font-weight: 700;
    color: #111827;
    margin-top: 4px;
}


/* TOPBAR */
#TopBar QLineEdit,
#TopBar QComboBox {
    background: #FFFFFF;
    border: 1px solid #D7DDE3;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 14px;
}

#TopBar QPushButton {
    background: #0B5CAD;
    color: white;
    border-radius: 12px;
    padding: 10px 16px;
    font-weight: 600;
    font-size: 14px;
}


/* Table headers */
QLabel#TableHeader {
    font-size: 17px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 12px;
}
/* BUTTON PRIMARY */
#AddSensor {
    background: #0B66C3;
    color: #FFFFFF;
}
#AddSensor:hover {
    background: #0857A5;
}

/* WINDOW */
QMainWindow {
    background: #F5F7FA;
    color: #1A1A1A;
}

/* SIDEBAR */
#Sidebar {
    background: #FFFFFF;
    border-right: 1px solid #E5E5E5;
}

/* CARDS */
#Card, QFrame#Card {
    background: #FFFFFF;
    border: 1px solid #EEE;
}

/* TEXT */
QLabel { color: #1A1A1A; }
QLabel#H1 { color: #1A1A1A; }
QLabel#Small { color: #555; }

#MeasureValue { color: #333; }

/* MEASUREMENT PILL */
#MeasurePill[kind="visc"]  { background: #E4EEF9; color: #1A1A1A; }
#MeasurePill[kind="temp"]  { background: #FFF2CC; color: #1A1A1A; }
#MeasurePill[kind="dens"]  { background: #E5F4EC; color: #1A1A1A; }
#MeasurePill[kind="pres"]  { background: #EFE9FF; color: #1A1A1A; }

/* BUTTONS */
QPushButton {
    background: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #DADADA;
}
QPushButton:hover { background: #EFEFEF; }

/* NAV */
#NavPrimary {
    background: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #D5D5D5;
}
#NavPrimary:hover { background: #EDEDED; }

#NavSecondary {
    background: #FAFAFA;
    color: #444;
    border: 1px solid #E0E0E0;
}
#NavSecondary:hover { background: #E8E8E8; }

/* TABLE */
QTableWidget {
    background: #FFFFFF;
    color: #1A1A1A;
    border-color: #EEE;
}
QHeaderView::section {
    background: #FFFFFF;
    color: #1A1A1A;
}
QTableWidget::item:selected { background: #E8E8E8; }

/* INPUTS */
QLineEdit {
    background: #FFFFFF;
    color: #1A1A1A;
    border-color: #CCC;
}
QComboBox {
    background: #FFFFFF;
    color: #1A1A1A;
    border-color: #CCC;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #1A1A1A;
}

/* SCROLLBAR */
QScrollBar:vertical { background: #F0F0F0; }
QScrollBar::handle:vertical { background: #CCC; }
QScrollBar::handle:vertical:hover { background: #BBB; }

/* HOVER CARD COLORS (LIGHT THEME) */
#HoverCard {
    background: #FFFFFF;
    border: 1px solid #E6E6E6;
}

#HoverCard[hover="true"] {
    background: #F9F9F9;
}

#ChartFrame {
    background: #FFFFFF;
    border: 1px solid #EEE;
}

#ChartTooltip QLabel#ChartTooltipLabel {
    color: #1A1A1A;
}
